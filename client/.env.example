VITE_API_BASE_URL=/api
# Google OAuth 2.0 Client ID — same value as server GOOGLE_CLIENT_ID. Public, safe to expose.
VITE_GOOGLE_CLIENT_ID=
# Facebook App ID — same value as server FACEBOOK_APP_ID. Public, safe to expose.
# Used to lazy-load the Facebook SDK (client/src/lib/facebook.ts) only when set.
VITE_FACEBOOK_APP_ID=
