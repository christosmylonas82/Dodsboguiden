DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dodsboguiden?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
# Set to "true" only when running behind a single trusted reverse proxy (e.g. Railway) so req.ip reflects the real client IP.
TRUST_PROXY=false
# This server's own publicly reachable origin, used to build the email-verification link
# (GET /auth/verify?token=...). In Railway, set this to the backend service's public domain.
API_BASE_URL="http://localhost:4000"
# Optional. Without a SENDGRID_API_KEY, outgoing emails are logged to the console instead of sent.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL="no-reply@dodsboguiden.se"
SENDGRID_FROM_NAME="DödsboGuiden"
