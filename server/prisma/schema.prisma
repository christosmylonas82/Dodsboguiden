generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemRole {
  USER
  ADMIN
}

enum ProjectRole {
  ADMIN
  MEMBER
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  NOW
  SOON
  LATER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  role         SystemRole @default(USER)
  gdprConsent  Boolean  @default(false) @map("gdpr_consent")
  consentDate  DateTime? @map("consent_date")
  hasSeenTipsOnboarding Boolean @default(false) @map("has_seen_tips_onboarding")
  profileImageUrl String? @db.Text @map("profile_image_url")
  createdAt    DateTime @default(now()) @map("created_at")
  deletedAt    DateTime? @map("deleted_at")

  ownedProjects  Project[]       @relation("ProjectOwner")
  memberships    ProjectMember[]
  completedTasks Task[]          @relation("TaskCompletedBy")
  assignedTasks  Task[]          @relation("TaskAssignee")
  activityLogs   ActivityLog[]
  auditLogs      AuditLog[]
  sentInvitations     Invitation[] @relation("InvitationSender")
  receivedInvitations Invitation[] @relation("InvitationRecipient")
  passwordResets      PasswordReset[]
  authEvents          AuthEvent[]

  @@map("users")
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model AuthEvent {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  email     String
  action    String
  ipAddress String?  @map("ip_address")
  country   String?
  city      String?
  latitude  Float?
  longitude Float?
  userAgent String?  @map("user_agent")
  timestamp DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([timestamp])
  @@index([userId])
  @@index([ipAddress])
  @@map("auth_events")
}

model Project {
  id            String        @id @default(uuid())
  ownerId       String        @map("owner_id")
  deceasedName  String        @map("deceased_name")
  deceasedDate  DateTime?     @map("deceased_date")
  status        ProjectStatus @default(ACTIVE)
  createdAt     DateTime      @default(now()) @map("created_at")
  deletedAt     DateTime?     @map("deleted_at")

  owner   User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  members ProjectMember[]
  tasks   Task[]
  activity ActivityLog[]
  contacts       Contact[]
  inventoryItems InventoryItem[]
  invitations    Invitation[]

  @@map("projects")
}

model ProjectMember {
  id        String      @id @default(uuid())
  projectId String      @map("project_id")
  userId    String?     @map("user_id")
  email     String
  role      ProjectRole @default(MEMBER)
  createdAt DateTime    @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])

  @@unique([projectId, email])
  @@map("project_members")
}

model Task {
  id          String     @id @default(uuid())
  projectId   String     @map("project_id")
  title       String
  description String?
  url         String?
  moreInfo    String?
  phase       String
  completed   Boolean    @default(false)
  completedBy String?    @map("completed_by")
  completedAt DateTime?  @map("completed_at")
  status      TaskStatus @default(PENDING)
  assignedTo  String?    @map("assigned_to")
  orderIndex  Int        @map("order_index")
  priority        TaskPriority? @map("priority")
  timeEstimate    String?       @map("time_estimate")
  responsibleRole String?       @map("responsible_role")
  notes           String?
  dueDate         DateTime?     @map("due_date")

  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  completedByUser User?   @relation("TaskCompletedBy", fields: [completedBy], references: [id])
  assignedUser    User?   @relation("TaskAssignee", fields: [assignedTo], references: [id])
  activity        ActivityLog[]

  @@map("tasks")
}

model ActivityLog {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  taskId    String?  @map("task_id")
  action    String
  timestamp DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])
  task    Task?   @relation(fields: [taskId], references: [id])

  @@map("activity_log")
}

model Contact {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  name      String
  relation  String
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("contacts")
}

model InventoryItem {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  type      String
  value     Int
  comments  String?
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("inventory_items")
}

model Invitation {
  id               String           @id @default(uuid())
  projectId        String           @map("project_id")
  senderUserId     String           @map("sender_user_id")
  invitedEmail     String           @map("invited_email")
  invitedUserId    String?          @map("invited_user_id")
  status           InvitationStatus @default(PENDING)
  invitationToken  String           @unique @map("invitation_token")
  tokenExpiresAt   DateTime         @map("token_expires_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  acceptedAt       DateTime?        @map("accepted_at")
  declinedAt       DateTime?        @map("declined_at")

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  senderUser  User    @relation("InvitationSender", fields: [senderUserId], references: [id])
  invitedUser User?   @relation("InvitationRecipient", fields: [invitedUserId], references: [id])

  @@map("invitations")
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String   @map("admin_id")
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  timestamp  DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id])

  @@map("audit_log")
}
