generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemRole {
  USER
  ADMIN
}

enum ProjectRole {
  ADMIN
  MEMBER
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  SKIPPED
}

enum InventoryStatus {
  NOT_INVENTORIED
  INVENTORIED
  VALUED
  SOLD
}

enum TransactionType {
  COST
  INCOME
}

enum TransactionCategory {
  BEGRAVNING
  JURIDIK
  MYNDIGHETER
  FORSALJNING
  OVRIGT
}

enum DocumentType {
  DODSFALLSINTYG
  TESTAMENTE
  FULLMAKT
  FORSAKRING
  OVRIGT
}

enum TaskPriority {
  NOW
  SOON
  LATER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum PostTaskType {
  ADDRESS_CHANGE
  MAIL_FORWARDING
  AD_BLOCK
}

enum PostTaskStatus {
  PENDING
  DONE
}

enum DigitalHeritageStatus {
  NOT_STARTED
  MEMORIAL
  DELETED
  ARCHIVED
}

enum PensionType {
  BARNPENSION
  OMSTALLNINGSPENSION
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  role         SystemRole @default(USER)
  gdprConsent  Boolean  @default(false) @map("gdpr_consent")
  consentDate  DateTime? @map("consent_date")
  hasSeenTipsOnboarding Boolean @default(false) @map("has_seen_tips_onboarding")
  onboardingVersionSeen Int @default(0) @map("onboarding_version_seen")
  profileImageUrl String? @db.Text @map("profile_image_url")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt    DateTime @default(now()) @map("created_at")
  deletedAt    DateTime? @map("deleted_at")

  ownedProjects  Project[]       @relation("ProjectOwner")
  memberships    ProjectMember[]
  completedTasks Task[]          @relation("TaskCompletedBy")
  assignedTasks  Task[]          @relation("TaskAssignee")
  activityLogs   ActivityLog[]
  auditLogs      AuditLog[]
  sentInvitations     Invitation[] @relation("InvitationSender")
  receivedInvitations Invitation[] @relation("InvitationRecipient")
  passwordResets      PasswordReset[]
  emailVerifications  EmailVerification[]
  authEvents          AuthEvent[]
  uploadedDocuments   Document[]
  notifications       Notification[]

  @@map("users")
}

model EmailVerification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verifications")
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model AuthEvent {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  email     String
  action    String
  ipAddress String?  @map("ip_address")
  country   String?
  city      String?
  latitude  Float?
  longitude Float?
  userAgent String?  @map("user_agent")
  timestamp DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([timestamp])
  @@index([userId])
  @@index([ipAddress])
  @@map("auth_events")
}

model Project {
  id            String        @id @default(uuid())
  ownerId       String        @map("owner_id")
  deceasedName  String        @map("deceased_name")
  deceasedDate  DateTime?     @map("deceased_date")
  deadlineReminder90SentAt DateTime? @map("deadline_reminder_90_sent_at")
  deadlineReminder60SentAt DateTime? @map("deadline_reminder_60_sent_at")
  deadlineReminder30SentAt DateTime? @map("deadline_reminder_30_sent_at")
  status        ProjectStatus @default(ACTIVE)
  selectedArchive String?     @map("selected_archive")
  hasCompany        Boolean @default(false) @map("has_company")
  hasCoOwnership    Boolean @default(false) @map("has_co_ownership")
  hasForeignAssets  Boolean @default(false) @map("has_foreign_assets")
  hasRentalProperty Boolean @default(false) @map("has_rental_property")
  hasDigitalAssets  Boolean @default(false) @map("has_digital_assets")
  createdAt     DateTime      @default(now()) @map("created_at")
  deletedAt     DateTime?     @map("deleted_at")

  owner   User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  members ProjectMember[]
  tasks   Task[]
  activity ActivityLog[]
  contacts       Contact[]
  inventoryItems InventoryItem[]
  invitations    Invitation[]
  transactions   Transaction[]
  documents      Document[]
  notifications  Notification[]
  postManagementTasks   PostManagementTask[]
  digitalHeritageItems  DigitalHeritageItem[]
  survivingPensionNotes SurvivingPensionNote[]
  housingBenefitNotes   HousingBenefitNote[]

  @@map("projects")
}

model ProjectMember {
  id        String      @id @default(uuid())
  projectId String      @map("project_id")
  userId    String?     @map("user_id")
  email     String
  role      ProjectRole @default(MEMBER)
  createdAt DateTime    @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])

  @@unique([projectId, email])
  @@map("project_members")
}

model Task {
  id          String     @id @default(uuid())
  projectId   String     @map("project_id")
  title       String
  description String?
  url         String?
  moreInfo    String?
  phase       String
  completed   Boolean    @default(false)
  completedBy String?    @map("completed_by")
  completedAt DateTime?  @map("completed_at")
  status      TaskStatus @default(PENDING)
  assignedTo  String?    @map("assigned_to")
  orderIndex  Int        @map("order_index")
  priority        TaskPriority? @map("priority")
  timeEstimate    String?       @map("time_estimate")
  responsibleRole String?       @map("responsible_role")
  notes           String?
  dueDate         DateTime?     @map("due_date")
  isCustom        Boolean       @default(false) @map("is_custom")

  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  completedByUser User?   @relation("TaskCompletedBy", fields: [completedBy], references: [id])
  assignedUser    User?   @relation("TaskAssignee", fields: [assignedTo], references: [id])
  activity        ActivityLog[]

  @@map("tasks")
}

model ActivityLog {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  taskId    String?  @map("task_id")
  action    String
  timestamp DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])
  task    Task?   @relation(fields: [taskId], references: [id])

  @@map("activity_log")
}

model Contact {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  name      String
  relation  String
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("contacts")
}

model InventoryItem {
  id        String          @id @default(uuid())
  projectId String          @map("project_id")
  type      String
  value     Int
  comments  String?
  status    InventoryStatus @default(NOT_INVENTORIED)
  createdAt DateTime        @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("inventory_items")
}

model Transaction {
  id          String              @id @default(uuid())
  projectId   String              @map("project_id")
  type        TransactionType
  category    TransactionCategory
  description String
  amount      Int
  date        DateTime            @default(now())
  notes       String?
  createdAt   DateTime            @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("transactions")
}

model Document {
  id          String       @id @default(uuid())
  projectId   String       @map("project_id")
  title       String
  type        DocumentType
  description String?
  fileData    String       @db.Text
  fileName    String       @map("file_name")
  fileSize    Int          @map("file_size")
  mimeType    String       @map("mime_type")
  uploadedBy  String       @map("uploaded_by")
  uploadedAt  DateTime     @default(now()) @map("uploaded_at")

  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedByUser User    @relation(fields: [uploadedBy], references: [id])

  @@index([projectId])
  @@map("documents")
}

model Notification {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@map("notifications")
}

model PostManagementTask {
  id          String         @id @default(uuid())
  projectId   String         @map("project_id")
  taskType    PostTaskType   @map("task_type")
  status      PostTaskStatus @default(PENDING)
  newAddress  String?        @map("new_address")
  notes       String?
  completedAt DateTime?      @map("completed_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, taskType])
  @@index([projectId])
  @@map("post_management_tasks")
}

model DigitalHeritageItem {
  id        String                @id @default(uuid())
  projectId String                @map("project_id")
  platform  String
  status    DigitalHeritageStatus @default(NOT_STARTED)
  notes     String?
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, platform])
  @@index([projectId])
  @@map("digital_heritage_items")
}

model SurvivingPensionNote {
  id                String      @id @default(uuid())
  projectId         String      @map("project_id")
  pensionType       PensionType @map("pension_type")
  childAge          Int?        @map("child_age")
  studyingGymnasium Boolean?    @map("studying_gymnasium")
  survivorAge       Int?        @map("survivor_age")
  hasChildren       Boolean?    @map("has_children")
  notes             String?
  createdAt         DateTime    @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("surviving_pension_notes")
}

model HousingBenefitNote {
  id              String   @id @default(uuid())
  projectId       String   @map("project_id")
  age             Int
  incomeBeforeTax Int      @map("income_before_tax")
  assets          Int
  housingCost     Int      @map("housing_cost")
  meetsAgeRequirement Boolean @map("meets_age_requirement")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("housing_benefit_notes")
}

model Invitation {
  id               String           @id @default(uuid())
  projectId        String           @map("project_id")
  senderUserId     String           @map("sender_user_id")
  invitedEmail     String           @map("invited_email")
  invitedUserId    String?          @map("invited_user_id")
  status           InvitationStatus @default(PENDING)
  invitationToken  String           @unique @map("invitation_token")
  tokenExpiresAt   DateTime         @map("token_expires_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  acceptedAt       DateTime?        @map("accepted_at")
  declinedAt       DateTime?        @map("declined_at")

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  senderUser  User    @relation("InvitationSender", fields: [senderUserId], references: [id])
  invitedUser User?   @relation("InvitationRecipient", fields: [invitedUserId], references: [id])

  @@map("invitations")
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String   @map("admin_id")
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  timestamp  DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id])

  @@map("audit_log")
}
